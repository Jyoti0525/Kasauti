# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Node (frontend lands in M2)
node_modules/
frontend/dist/

# Runtime data: never commit configs, vaults, databases or keys
/var/
*.db
*.db-wal
*.db-shm
*.sqlite
vault/
*.key
*.pem
*.p12
secrets/

# Model weights are downloaded and hash-pinned, never committed (PLAN §17)
models/
*.safetensors
*.bin
*.gguf

# Evaluation outputs (reports are generated; keep the harness only)
eval/reports/*
!eval/reports/.gitkeep
# ...except the measurements the README quotes; eval/tests check they match a fresh run.
!eval/reports/lovo.md
!eval/reports/huawei_teach.md

# Raw third-party data is fetched by tools, not committed unless recorded in SOURCES.md
datasets/_downloads/
datasets/nassim/

# Local tooling and scratch
.playwright-mcp/
.idea/
.vscode/
*.log
sbom*.json

# Audit outputs: even masked, a real device's report must never be committed by accident.
*.kasauti.json
*.kasauti.pdf
/reports/
