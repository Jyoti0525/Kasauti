{
  "$defs": {
    "Benchmark": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "released": {
          "title": "Released",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "sunset": {
          "default": false,
          "title": "Sunset",
          "type": "boolean"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "vendors": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Vendors",
          "type": "array"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "released",
        "vendors",
        "source"
      ],
      "title": "Benchmark",
      "type": "object"
    },
    "Control": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark"
        },
        "ccis": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ccis",
          "type": "array"
        },
        "fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "nist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Nist",
          "type": "array"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "vuln_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vuln Id"
        }
      },
      "required": [
        "id"
      ],
      "title": "Control",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "released": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "title",
        "version",
        "url",
        "sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmarks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Benchmark"
      },
      "title": "Benchmarks",
      "type": "array"
    },
    "bridge": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/Control"
      },
      "title": "Controls",
      "type": "array"
    },
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "framework": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "title": "Framework",
      "type": "string"
    },
    "licence": {
      "title": "Licence",
      "type": "string"
    },
    "retrieved": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Retrieved",
      "type": "string"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "withdrawn": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Withdrawn",
      "type": "object"
    }
  },
  "required": [
    "format_version",
    "framework",
    "title",
    "version",
    "source_url",
    "licence",
    "retrieved",
    "controls"
  ],
  "title": "FrameworkCatalog",
  "type": "object"
}
