          "title": "Reviewed By"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "source": {
          "enum": [
            "authored",
            "olir-155",
            "stig-cci",
            "semantic-proposal"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "controls",
        "source"
      ],
      "title": "CrosswalkEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
