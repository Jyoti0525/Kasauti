        "$ref": "#/$defs/CrosswalkEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "framework": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "title": "Framework",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "framework"
  ],
  "title": "Crosswalk",
  "type": "object"
