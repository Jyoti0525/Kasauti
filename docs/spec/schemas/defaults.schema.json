{
  "$defs": {
    "DefaultEntry": {
      "additionalProperties": false,
      "description": "What holds when the configuration says nothing, for an OS version range.\n\nTwo forms:\n\n* ``attr`` + ``value``: an attribute's default (``MgmtSession.idle_timeout_s = 600``).\n  With ``entity_key`` it names one entity (``MgmtService`` ``telnet``) and materialises it\n  if the config never mentions it; without, it fills that attribute on every entity of\n  the type (or on the singleton).\n* ``none_of``: the vendor ships *no* entities of this type (no SNMP communities until\n  one is configured). Only this lets a rule treat \"none seen\" as \"none exist\".",
      "properties": {
        "attr": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Za-z]+\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attr"
        },
        "entity_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Key"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "none_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "None Of"
        },
        "os_versions": {
          "default": "*",
          "title": "Os Versions",
          "type": "string"
        },
        "reference": {
          "minLength": 3,
          "title": "Reference",
          "type": "string"
        },
        "source": {
          "enum": [
            "vendor_manual",
            "vendor_doc",
            "curated"
          ],
          "title": "Source",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "source",
        "reference"
      ],
      "title": "DefaultEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DefaultEntry"
      },
      "title": "Defaults",
      "type": "array"
    }
  },
  "title": "DefaultsFile",
  "type": "object"
}
