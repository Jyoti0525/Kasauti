{
  "$defs": {
    "Records": {
      "additionalProperties": false,
      "description": "How a JSON/YAML pack's list items read (TODO M2.31). Cloud exports keep one rule's facts\nin separate fields of one object (``IpProtocol``, ``FromPort``, ``ToPort``), and a mapping\nreads one statement: each list item's scalar fields, and those of the objects inside it\n(``PortRange.From``), are rendered as one statement, ``@`` then each key and value in key\norder. Lists inside the item are rendered as before, beneath it. An object giving a key\ntwice is refused (read line by line, with the reason): readers differ on which one counts.",
      "properties": {
        "names": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Names",
          "type": "object"
        },
        "sections": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "title": "Records",
      "type": "object"
    },
    "Role": {
      "enum": [
        "router",
        "switch",
        "firewall",
        "cloud_filter",
        "white_box"
      ],
      "title": "Role",
      "type": "string"
    },
    "SetForm": {
      "additionalProperties": false,
      "description": "How CLI commands stand for the pack's brace configuration (TODO M2.28). A file of\ncommands or a terminal capture is replayed (:mod:`kasauti.mapping.commands`); each\nstatement left is a path of words, split into blocks where the pack's own mappings expect\nthem (:mod:`kasauti.mapping.setform`), so the same mappings read every form.",
      "properties": {
        "leaf_lists": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Leaf Lists",
          "type": "array"
        }
      },
      "title": "SetForm",
      "type": "object"
    },
    "ShapeFamily": {
      "description": "The seven structural families plus the flat fallback (PLAN §6.1).",
      "enum": [
        "indent",
        "brace",
        "set_path",
        "block_edit",
        "path_command",
        "xml",
        "json_yaml",
        "flat"
      ],
      "title": "ShapeFamily",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comment_markers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Comment Markers",
      "type": "array"
    },
    "default_role": {
      "anyOf": [
        {
          "$ref": "#/$defs/Role"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "negation_words": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Negation Words",
      "type": "array"
    },
    "os_family": {
      "title": "Os Family",
      "type": "string"
    },
    "pack_version": {
      "minimum": 1,
      "title": "Pack Version",
      "type": "integer"
    },
    "records": {
      "anyOf": [
        {
          "$ref": "#/$defs/Records"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "set_form": {
      "anyOf": [
        {
          "$ref": "#/$defs/SetForm"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shape_family": {
      "$ref": "#/$defs/ShapeFamily"
    },
    "time_unit": {
      "default": "seconds",
      "enum": [
        "seconds",
        "minutes"
      ],
      "title": "Time Unit",
      "type": "string"
    },
    "vendor": {
      "title": "Vendor",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "id",
    "name",
    "vendor",
    "os_family",
    "shape_family",
    "pack_version"
  ],
  "title": "VendorManifest",
  "type": "object"
}
